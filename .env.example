# Copy to .env.local; never commit real keys.
GEMINI_API_KEY=
GUIDE_GENERATION_ENABLED=false
GUIDE_MODEL_PROVIDER=gemini
GUIDE_MODEL=gemini-3.5-flash-lite
# Optional persistent-disk directories; relative to the project by default.
# GUIDE_STORAGE_DIR=.local/generated-guides
# GUIDE_JOB_DIR=.local/generation-jobs
# Saved-guide backend: file (local default) or supabase (durable hosted storage).
GUIDE_STORAGE_BACKEND=file
SUPABASE_URL=
# Server-side only. Never prefix with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SECRET_KEY=

# Shared access code for invited generation testers. Required on production.
# Use a random 12–128 character value, never a real account password.
GUIDE_ACCESS_PIN=
